# ============================================================================
# 301 REDIRECTS — PROPOSED REVISION of docs/prod-redirects.htaccess (2026-09-15)
# ----------------------------------------------------------------------------
# Same purpose and placement as the original (top of the PRODUCTION .htaccess,
# above the SPA front-controller rules). Changes, see docs/IMPROVEMENTS.md:
#   A4  apex -> www host rule first; absolute targets (one hop, no chains)
#   B1  the 16 old URLs that fell through now redirect, or return 410
#   B2  comprar-/precio- pages go to their category, not the generic /productos
#   B3  heating (calefaccion, radiador, caldera) -> fontaneria, not climatizacion
#
# `node scripts/check-redirects.mjs docs/seo/prod-redirects.proposed.htaccess`
# -> all 755 old URLs resolved, exit 0. Review, then replace the original.
#
# TODO before launch: /mantenimiento/ points at /quienes-somos as a placeholder —
# read the old page and pick its real destination.
# Same-slug pages (financiacion, hazte-cliente, aviso-legal, politica-privacidad)
# are intentionally omitted: the SPA serves those exact paths.
# ============================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Canonical host (WordPress used to do this; it goes away with it) ---
  RewriteCond %{HTTP_HOST} ^saneamientos-pereda\.com$ [NC]
  RewriteRule ^ https://www.saneamientos-pereda.com%{REQUEST_URI} [R=301,L]

  # --- WooCommerce shop -> professional ecommerce subdomain ---
  RewriteRule ^(tienda|tienda-online|carrito|finalizar-compra|mi-cuenta)(/.*)?$ https://ecommerce.saneamientos-pereda.com/ [R=301,L]

  # --- WordPress leftovers: gone for good ---
  RewriteRule ^(hola-mundo|prueba|author|category|area-item)(/.*)?$ - [G,L]

  # --- Fixed pages whose slug DIFFERS from the new site ---
  RewriteRule ^cita/?$                 https://www.saneamientos-pereda.com/pide-cita          [R=301,L]
  RewriteRule ^contacto/?$             https://www.saneamientos-pereda.com/instalaciones      [R=301,L]
  RewriteRule ^trabaja-con-nosotros/?$ https://www.saneamientos-pereda.com/quienes-somos      [R=301,L]
  RewriteRule ^politica-de-cookies/?$  https://www.saneamientos-pereda.com/politica-cookies   [R=301,L]
  RewriteRule ^condiciones-de-venta/?$ https://www.saneamientos-pereda.com/condiciones-venta  [R=301,L]
  RewriteRule ^(consentimiento|tratamiento-candidato)/?$ https://www.saneamientos-pereda.com/politica-privacidad [R=301,L]
  RewriteRule ^mantenimiento/?$        https://www.saneamientos-pereda.com/quienes-somos      [R=301,L]
  RewriteRule ^instalacion-de-mamparas-de-ducha/?$ https://www.saneamientos-pereda.com/productos/mamparas [R=301,L]

  # --- "comprar-…" / "precio-…" pages that name their product: before the generic rules ---
  RewriteRule ^(comprar|precio)-(mueble|muebles|armario|armarios|espejo|espejos)[-/] https://www.saneamientos-pereda.com/productos/muebles-bano [R=301,L]
  RewriteRule ^(comprar|precio)-(mampara|mamparas)[-/] https://www.saneamientos-pereda.com/productos/mamparas [R=301,L]
  RewriteRule ^(comprar|precio)-(grifo|grifos|griferia|griferias)[-/] https://www.saneamientos-pereda.com/productos/griferia [R=301,L]

  # --- Programmatic SEO landing pages -> closest category ---
  # (the trailing [-/] means: the slug continues with "-word…" or is the bare "/")
  RewriteRule ^(mueble|muebles|armario|armarios|espejo|espejos|estanteria|estanterias|mobiliario)[-/] https://www.saneamientos-pereda.com/productos/muebles-bano [R=301,L]
  RewriteRule ^(mejores-)?(mampara|mamparas)[-/] https://www.saneamientos-pereda.com/productos/mamparas [R=301,L]
  RewriteRule ^(griferia|griferias|grifo|grifos)[-/] https://www.saneamientos-pereda.com/productos/griferia [R=301,L]
  RewriteRule ^(sanitario|sanitarios|inodoro|inodoros|lavabo|lavabos|bide|bides|cisterna)[-/] https://www.saneamientos-pereda.com/productos/sanitarios [R=301,L]
  RewriteRule ^(suelo|suelos|azulejo|azulejos|revestimiento|revestimientos|porcelanico|porcelanicos|ceramica|ceramicas|baldosa|baldosas|pavimento)[-/] https://www.saneamientos-pereda.com/productos/ceramica [R=301,L]
  RewriteRule ^(calefaccion|radiador|radiadores|caldera|calderas)[-/] https://www.saneamientos-pereda.com/productos/fontaneria [R=301,L]
  RewriteRule ^(climatizacion|aerotermia)[-/] https://www.saneamientos-pereda.com/productos/climatizacion [R=301,L]

  # --- Remaining "comprar-…", "precio-…" and store-locator pages ---
  RewriteRule ^comprar[-/]             https://www.saneamientos-pereda.com/productos          [R=301,L]
  RewriteRule ^precio[-/]              https://www.saneamientos-pereda.com/productos          [R=301,L]
  RewriteRule ^(mejores-tiendas|tiendas)[-/] https://www.saneamientos-pereda.com/instalaciones [R=301,L]

  # --- Portfolio / ambientes ---
  RewriteRule ^portfolio(/.*)?$        https://www.saneamientos-pereda.com/inspirate          [R=301,L]

  # --- Old Yoast / WordPress sitemaps -> our dynamic sitemap ---
  RewriteRule ^(sitemap_index|wp-sitemap|page-sitemap|post-sitemap|portfolio-sitemap|area-item-sitemap|category-sitemap|author-sitemap)\.xml$ https://www.saneamientos-pereda.com/sitemap.xml [R=301,L]
</IfModule>
