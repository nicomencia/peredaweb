# SPA routing: every request that isn't a real file/dir goes through the PHP
# front controller (index.php), which injects per-route SEO metadata and serves
# the React shell. Static assets (assets/, media/, *.webp, …) are served directly.
DirectoryIndex index.php

# Compression: the host has mod_deflate (the old WordPress site is gzipped) but
# nothing enabled it here, so HTML, the 400 KB JS bundle and the JSON API went out
# uncompressed. Applies to PHP output too (index.php, api/*.php).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caching: /assets/* filenames are content-hashed by Vite, so a new build always
# gets new names and a one-year immutable cache is safe. NOT for /base/ or /media/,
# whose paths get reused, and not for index.php output (per-route SEO meta).
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host. WordPress used to send apex -> www itself; without it both
  # hosts would serve a full self-canonical copy of the site. Matches only the
  # bare domain, so it is inert on dev.
  RewriteCond %{HTTP_HOST} ^saneamientos-pereda\.com$ [NC]
  RewriteRule ^ https://www.saneamientos-pereda.com%{REQUEST_URI} [R=301,L]

  # index.html is the raw shell (no per-route meta, no canonical): never serve it
  # at its own URL.
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ / [R=301,L]

  # ==========================================================================
  # 301 map: old WordPress URLs -> new routes. Every one of the 755 URLs in the
  # old Yoast sitemap (docs/seo/old-site-urls.txt) resolves; verify any change
  # with `node scripts/check-redirects.mjs` (exit 0 = nothing falls through).
  # Targets are relative so the same file can be tested on dev.
  # ==========================================================================
  # --- WooCommerce shop -> professional ecommerce subdomain ---
  RewriteRule ^(tienda|tienda-online|carrito|finalizar-compra|mi-cuenta)(/.*)?$ https://ecommerce.saneamientos-pereda.com/ [R=301,L]

  # --- WordPress leftovers: gone for good ---
  RewriteRule ^(hola-mundo|prueba|author|category|area-item)(/.*)?$ - [G,L]

  # --- Fixed pages whose slug DIFFERS from the new site ---
  RewriteRule ^cita/?$                 /pide-cita          [R=301,L]
  RewriteRule ^contacto/?$             /instalaciones      [R=301,L]
  RewriteRule ^trabaja-con-nosotros/?$ /quienes-somos      [R=301,L]
  RewriteRule ^politica-de-cookies/?$  /politica-cookies   [R=301,L]
  RewriteRule ^condiciones-de-venta/?$ /condiciones-venta  [R=301,L]
  RewriteRule ^(consentimiento|tratamiento-candidato)/?$ /politica-privacidad [R=301,L]
  # WordPress "página en construcción" placeholder: no content of its own.
  RewriteRule ^mantenimiento/?$        /                   [R=301,L]
  RewriteRule ^instalacion-de-mamparas-de-ducha/?$ /productos/mamparas [R=301,L]

  # --- "comprar-…" / "precio-…" pages that name their product: before the generic rules ---
  RewriteRule ^(comprar|precio)-(mueble|muebles|armario|armarios|espejo|espejos)[-/] /productos/muebles-bano [R=301,L]
  RewriteRule ^(comprar|precio)-(mampara|mamparas)[-/] /productos/mamparas [R=301,L]
  RewriteRule ^(comprar|precio)-(grifo|grifos|griferia|griferias)[-/] /productos/griferia [R=301,L]

  # --- Programmatic SEO landing pages -> closest category ---
  # (the trailing [-/] means: the slug continues with "-word…" or is the bare "/")
  RewriteRule ^(mueble|muebles|armario|armarios|espejo|espejos|estanteria|estanterias|mobiliario)[-/] /productos/muebles-bano [R=301,L]
  RewriteRule ^(mejores-)?(mampara|mamparas)[-/] /productos/mamparas [R=301,L]
  RewriteRule ^(griferia|griferias|grifo|grifos)[-/] /productos/griferia [R=301,L]
  RewriteRule ^(sanitario|sanitarios|inodoro|inodoros|lavabo|lavabos|bide|bides|cisterna)[-/] /productos/sanitarios [R=301,L]
  RewriteRule ^(suelo|suelos|azulejo|azulejos|revestimiento|revestimientos|porcelanico|porcelanicos|ceramica|ceramicas|baldosa|baldosas|pavimento)[-/] /productos/ceramica [R=301,L]
  RewriteRule ^(calefaccion|radiador|radiadores|caldera|calderas)[-/] /productos/fontaneria [R=301,L]
  RewriteRule ^(climatizacion|aerotermia)[-/] /productos/climatizacion [R=301,L]

  # --- Remaining "comprar-…", "precio-…" and store-locator pages ---
  RewriteRule ^comprar[-/]             /productos          [R=301,L]
  RewriteRule ^precio[-/]              /productos          [R=301,L]
  RewriteRule ^(mejores-tiendas|tiendas)[-/] /instalaciones [R=301,L]

  # --- Portfolio / ambientes ---
  RewriteRule ^portfolio(/.*)?$        /inspirate          [R=301,L]

  # --- Old Yoast / WordPress sitemaps -> our dynamic sitemap ---
  RewriteRule ^(sitemap_index|wp-sitemap|page-sitemap|post-sitemap|portfolio-sitemap|area-item-sitemap|category-sitemap|author-sitemap)\.xml$ /sitemap.xml [R=301,L]

  # --- SPA front controller ---
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>
